// GreenManServer配置文件：每个配置项上方的中文说明仅供阅读，请勿删除配置项名称。
{
  // TAB页眉显示的服务器名称，最多48个Unicode字符。
  "tabServerName": "GreenManServer",
  // 玩家UUID到称号列表的映射，建议使用游戏内title命令维护，不要手工破坏UUID结构。
  "titles": {},
  // 是否显示TAB页眉页脚中的时间、TPS、MSPT和内存状态，默认true。
  "tabStatusEnabled": true,
  // 是否显示玩家称号，默认true。
  "titleEnabled": true,
  // 是否在玩家头顶和TAB名称中显示Ping，默认true。
  "latencyDisplayEnabled": true,
  // 是否启用独立定时公告，默认false；开启后按scheduledAnnouncementMode执行全服广播。
  "scheduledAnnouncementEnabled": false,
  // 定时公告模式：interval按分钟间隔，daily每天指定时间，weekly每周指定星期和时间，monthly每月指定日期和时间。
  "scheduledAnnouncementMode": "interval",
  // interval模式的公告间隔，单位分钟，允许1至1000000，默认60。
  "scheduledAnnouncementIntervalMinutes": 60,
  // daily、weekly、monthly模式的触发时间，格式HH:mm，默认20:00，使用服务器本地时区。
  "scheduledAnnouncementTime": "20:00",
  // weekly模式的星期编号，1为周一、7为周日，默认1。
  "scheduledAnnouncementWeekday": 1,
  // monthly模式的日期，允许1至31；当月不存在该日期时跳过，默认1。
  "scheduledAnnouncementMonthDay": 1,
  // 定时公告标题，支持颜色和格式符号，独立于进服公告标题。
  "scheduledAnnouncementTitle": "\u00266\u0026l[定时公告]",
  // 定时公告正文，支持换行、颜色和格式符号，独立于进服公告正文。
  "scheduledAnnouncementText": "\u0026e请管理员设置定时公告内容。",
  // 是否启用堆肥桶高频连续填充，默认true。
  "composterEnabled": true,
  // 是否限制普通玩家聊天频率、长度和重复消息，OP不受影响，默认true。
  "chatLimitEnabled": true,
  // 普通玩家两次聊天之间的冷却秒数，允许0至60，默认3。
  "chatCooldownSeconds": 3,
  // 单条聊天最大Unicode字符数，允许1至256，默认128。
  "chatMaxLength": 128,
  // 禁止重复发送相同消息的时间窗口秒数，允许0至300，默认30。
  "chatRepeatWindowSeconds": 30,
  // 是否把成功发送的玩家聊天保存到服务器本地，默认true。
  "chatArchiveEnabled": true,
  // 聊天归档文件保留天数，允许1至3650，默认30。
  "chatArchiveRetentionDays": 30,
  // 单个聊天归档文件大小上限，单位MiB，允许1至1024，默认16。
  "chatArchiveMaxFileSizeMib": 16,
  // 是否在玩家重新进入时回放最近聊天，默认true。
  "chatHistoryEnabled": true,
  // 内存缓存和玩家上线回放的最近聊天条数，允许0至500，默认50。
  "chatHistoryCacheSize": 50,
  // 是否启用玩家进入服务器时的公告提醒，默认true。
  "announcementEnabled": true,
  // 公告标题及样式，支持&0-&f颜色码、&k-&o格式码和&r重置码，默认金色粗体服务器公告。
  "announcementTitle": "\u00266\u0026l[服务器公告]",
  // 公告正文，最多2048个Unicode字符，允许换行；空字符串表示不显示公告。
  "announcementText": "",
  // 公告版本号，使用公告设置命令时自动增加；通常不需要手工修改。
  "announcementVersion": 0,
  // 是否每次进入都显示公告，默认true；false时同一公告版本每名玩家只显示一次。
  "announcementShowEveryJoin": true,
  // 是否默认允许普通成员使用@所有人，默认false；OP不受限制。
  "memberGlobalMentionEnabled": false,
  // 普通成员全服提醒次数统计窗口，单位秒，允许1至3600，默认60。
  "memberGlobalMentionWindowSeconds": 60,
  // 普通成员在统计窗口内允许的全服提醒次数，允许1至20，默认1。
  "memberGlobalMentionMaxCount": 1,
  // 玩家UUID到单独权限的映射，true为允许、false为禁止，未记录则跟随全局开关。
  "memberGlobalMentionOverrides": {},
  // 是否启用保守内存压力管理和自动GC请求，默认true。
  "memoryOptimizationEnabled": true,
  // 是否启用聊天@玩家、补全、高亮和提示音，默认true。
  "mentionsEnabled": true,
  // 是否在被@时于经验条和护甲值上方显示Action Bar提醒，默认true；关闭后仍保留聊天高亮和音效。
  "mentionActionBarEnabled": true,
  // 是否允许使用损耗弓合成发射器，默认true。
  "dispenserRecipeEnabled": true,
  // 是否高优先级保护稳定区块中的生物、船和矿车不在实体区块卸载时消失；新区块加载阶段自动使用原版流程以避免生物鬼畜，默认true。
  "entityUnloadProtectionEnabled": true,
  // 是否高优先级保护原版红石和TNT机制，默认true。
  "vanillaRedstoneProtectionEnabled": true,
  // 是否允许铁砧名称使用&颜色和格式码，默认true。
  "anvilNameColorEnabled": true,
  // 是否记录实体卸载和红石保护的详细拦截日志，默认false以避免刷屏。
  "debugLoggingEnabled": false,
  // 是否启用自定义封禁与踢出断开界面，默认true；false时回退原版提示。
  "punishmentTemplatesEnabled": true,
  // 封禁和踢出界面的独立服务器标题，支持&格式码，不再强制使用TAB名称。
  "punishmentServerTitle": "GreenManServer",
  // 封禁界面{action}变量显示的动作文字，页面会自动在前面加入玩家名称，默认显示玩家xxx已被封禁。
  "banActionText": "已被封禁",
  // 踢出界面{action}变量显示的动作文字，页面会自动在前面加入玩家名称，默认显示玩家xxx已被踢出。
  "kickActionText": "已被踢出",
  // 封禁界面模板，支持换行、&格式码以及{server_title}、{action}、{reason}、{ban_count}、{solution}、{expires_at}、{operator}变量；{ban_count}为玩家累计封禁次数。
  "banScreenTemplate": "\u0026c{server_title}\n\u0026f操作：\u0026e{action}\n\u0026f原因：\u0026e{reason}\n\u0026f封禁次数：\u0026e{ban_count}\n\u0026f解决方法：\u0026b{solution}\n\u0026f到期时间：\u0026e{expires_at}\n\u00267处理人：{operator}",
  // 踢出界面模板，支持换行、&格式码以及{server_title}、{action}、{reason}、{solution}、{operator}变量。
  "kickScreenTemplate": "\u0026c{server_title}\n\u0026f操作：\u0026e{action}\n\u0026f原因：\u0026e{reason}\n\u0026f解决方法：\u0026b{solution}\n\u00267处理人：{operator}",
  // 封禁和踢出界面{solution}变量使用的申诉提示，默认提醒电脑用户带边框截图、手机用户直接截屏后联系管理员，支持&格式码。
  "punishmentSolutionText": "请勿立即关闭此界面，带边框截图此界面并找管理员申诉，手机用户直接截屏即可",
  // 是否在服务器聊天栏广播封禁和踢出信息，默认true；普通命令与Grim自动处罚共用此开关。
  "punishmentChatBanAnnouncementEnabled": true,
  // 封禁和踢出共用的聊天公告主模板，支持{server_title}、{action}、{player_name}、{player_id}、{duration}、{reason}、{operator}，以及&颜色码、&#RRGGBB和&u彩虹符号；踢出时{duration}显示仅本次连接。
  "punishmentChatBanAnnouncementTemplate": "\u0026c[{server_title}]\u0026e玩家{player_name}\u0026c{action}\u0026f，时长：\u0026e{duration}\u0026f，原因：\u0026e{reason}\u0026f，处理人：\u0026b{operator}",
  // 是否接收Grim反作弊自动封禁，默认true；关闭后不会执行自动处罚。
  "grimAnticheatEnabled": true,
  // 同一IP第一次被Grim处罚的玩家封禁时长，默认12h。
  "grimFirstBanDuration": "12h",
  // 同一IP第二次被Grim处罚的玩家封禁时长，默认7d。
  "grimSecondBanDuration": "7d",
  // 同一IP第三次被Grim处罚的玩家封禁时长，默认30d。
  "grimThirdBanDuration": "30d",
  // 同一IP累计到多少次反作弊封禁时永久banip；默认4，表示超过三次后生效。
  "grimPermanentIpBanAfterCount": 4,
  // 同一玩家连续累计多少次反作弊异常后才执行当前轮处罚，默认3；第一次只提醒在线OP，达到阈值后才踢出，重进后再次达到阈值才封禁。
  "grimStreakKickThreshold": 3,
  // 同一玩家同一检测的Grim警报日志节流时间，单位秒，默认5；设置0关闭节流。
  "grimAlertLogCooldownSeconds": 5,
  // 是否对SafeWalk只报告给在线OP而不执行踢出、封禁或banip，默认true；可使用/greenman config set grimSafeWalkExempt enable或disable调整。
  "grimSafeWalkExemptEnabled": true,
  // 封禁聊天公告发送时是否向全服播放音效，默认true。
  "punishmentBanSoundEnabled": true,
  // 封禁音效模式：VANILLA播放原版音效，INTERNAL播放GreenManMusic内部音频，BOTH两者都播放，OFF关闭。
  "punishmentBanSoundMode": "VANILLA",
  // 封禁公告播放的原版声音ID数组，最多8个，默认雷声音效。
  "punishmentBanVanillaSoundIds": [
    "minecraft:entity.lightning_bolt.thunder"
  ],
  // 封禁公告使用的GreenManMusic内部OGG文件名，默认ban.ogg。
  "punishmentBanInternalMusicFile": "ban.ogg",
  // 是否允许服务器投票，默认true；管理员发起投票和玩家投票均受此开关影响。
  "votingEnabled": true,
  // 投票结束后是否公开每个玩家的选择和具体时间，默认true；关闭时只公布汇总。
  "voteResultsDetailEnabled": true,
  // 单个投票允许的最大持续时间，单位秒，范围1至86400，默认600。
  "voteMaxDurationSeconds": 600,
  // 单个投票允许的最大选项数，范围2至10，默认6。
  "voteMaxOptionCount": 6,
  // 是否启用玩家禁言，默认true；禁言记录保留在独立文件，管理员和普通玩家均按记录限制聊天。控制台可处理所有玩家。
  "muteEnabled": true,
  // 禁言聊天公告模板，支持{server_title}、{player_name}、{player_id}、{duration}、{reason}、{operator}、{created_at}、{expires_at}和&颜色格式符号。
  "muteChatAnnouncementTemplate": "\u0026c[{server_title}] \u0026e{player_name} \u0026c被禁言\u0026f，禁言时长：\u0026e{duration}\u0026f，原因：\u0026e{reason}\u0026f，处理人：\u0026b{operator}",
  // 是否启用掉落物自动清除，默认true；只清除地面ItemEntity，不影响经验球、生物、船、矿车和其他实体。
  "itemClearEnabled": true,
  // 掉落物自动清除间隔，单位分钟，允许1至1000000，默认5。
  "itemClearIntervalMinutes": 5,
  // 掉落物清除前的倒计时秒数，允许1至60，默认10；不超过20秒时先提示起始秒数，再提示10、5、3、2、1；超过20秒时从一半开始折半提示，再衔接10、5、3、2、1；倒计时不改变清除间隔。
  "itemClearCountdownSeconds": 10,
  // 是否仅在玩家使用鞘翅滑翔时跳过原版移动过快拉回，默认true；普通移动、非法坐标、碰撞校验和其他反作弊逻辑保持原版。
  "elytraMovementCheckBypassEnabled": true,
  // 触发自动GC判定的最大堆内存使用率百分比，允许60至95，默认70。
  "memoryPressureThresholdPercent": 70,
  // 自动和手动GC请求共用的冷却秒数，允许1至3600，默认600。
  "memoryGcCooldownSeconds": 600,
  // 是否拦截已知模组更新检查、版本检查和遥测主机，默认true；Minecraft登录与正版验证始终放行。
  "disableModNetworkChecks": true,
  // 是否使用原版IOWorker异步协调启动存储预热和关服提前保存，默认true；关闭后完全使用原版保存流程。
  "asyncChunkIoEnabled": true,
  // 允许触发进服欢迎的玩家UUID列表，默认空列表；只有列表内玩家进入时才触发个人欢迎、全服欢迎文字和音效，其他玩家进入不播报。
  "joinMessageAllowedPlayerUuids": [],
  // 是否启用玩家进服提示，默认true；可使用/greenman join命令控制。
  "joinMessageEnabled": true,
  // 是否向刚加入的玩家发送个人欢迎提示，默认true。
  "joinMessagePersonalEnabled": true,
  // 白名单玩家进入时是否向全服在线玩家广播欢迎文字，默认true；关闭后仍可按个人提示开关只欢迎加入者本人。
  "joinMessageBroadcastEnabled": true,
  // 是否播放进服音效，默认true。
  "joinSoundEnabled": true,
  // 白名单玩家触发欢迎时是否把音效播放给全服在线玩家，默认true；关闭后只播放给触发欢迎的玩家。
  "joinSoundBroadcastEnabled": true,
  // 进服音效模式：VANILLA同时播放原版音效列表，INTERNAL播放GreenManMusic音频，BOTH同时启用两者，OFF关闭。
  "joinSoundMode": "VANILLA",
  // VANILLA模式的原版声音ID，例如minecraft:entity.lightning_bolt.thunder。
  "joinVanillaSoundId": "minecraft:entity.lightning_bolt.thunder",
  // 同时播放的原版声音ID数组，最多8个；旧版joinVanillaSoundId会自动迁移到此列表。
  "joinVanillaSoundIds": [
    "minecraft:entity.lightning_bolt.thunder"
  ],
  // INTERNAL模式使用GreenManMusic目录中的文件名；OGG可直接使用，MP3/WAV需要服务器安装FFmpeg转换。
  "joinInternalMusicFile": "",
  // 玩家进入后延迟多少秒播放音效，允许0至60，默认1；可使用/greenman join sound delay修改。
  "joinSoundDelaySeconds": 1,
  // 完整HTTP或HTTPS资源包地址，非空时优先级最高；适合自定义路径、反向代理或CDN，留空时使用下面的公网主机自动生成。
  "joinMusicResourcePackUrl": "",
  // 内网穿透提供的公网域名或IP，只填写主机即可；误填的http://、端口和路径会自动去除。留空且未填写完整URL时不能下发内部音频。
  "joinMusicPublicHost": "",
  // 玩家客户端访问内网穿透入口所用的公网端口，允许1至65535；可与本地joinMusicHttpPort不同。
  "joinMusicPublicPort": 8765,
  // 自动生成资源包地址时是否使用HTTPS；默认false。仅当穿透平台或反向代理确实提供HTTPS时开启。
  "joinMusicPublicHttps": false,
  // 是否要求客户端接受自定义音乐资源包；默认true，拒绝时客户端会按原版规则断开。
  "joinMusicResourcePackRequired": true,
  // GreenManMusic内置资源包下载服务端口，允许1024至65535，默认8765；防火墙和端口映射需由管理员配置。
  "joinMusicHttpPort": 8765
}
